# Convex deployment env vars. Set these via `npx convex env set KEY VALUE`,
# NOT by creating a .env file (Convex deployments read env from the dashboard
# or CLI, not from local files).

# Mirror of NEXT_PUBLIC_DEV_MODE on the Convex deployment. When "true",
# `resolveIdentity` falls back to the devUserId passed from the client
# instead of reading a Clerk JWT, and `seedDevDataPublic` becomes callable.
# Set via: npx convex env set CONVEX_DEV_MODE true
CONVEX_DEV_MODE=false

# Google AI Studio API Key (required for the Homie chat agent —
# gemini-3.1-flash-lite). Get one at https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=your_google_ai_studio_key_here

# OpenAI API Key (still required for embeddings — text-embedding-3-small
# feeds the Qdrant profile-items index)
OPENAI_API_KEY=your_openai_api_key_here

# Qdrant Cloud (required for the Homie agent's friend-graph RAG tools)
QDRANT_URL=https://your-cluster.qdrant.io
QDRANT_API_KEY=your_qdrant_api_key_here
