# Vapi Configuration
NEXT_PUBLIC_VAPI_API_KEY=your_api_key_here
NEXT_PUBLIC_VAPI_ASSISTANT_ID=your_assistant_id_here

# Optional: Vapi Server URL (defaults to production)
# NEXT_PUBLIC_VAPI_BASE_URL=https://api.vapi.ai

# Qdrant Configuration for Vector Search (Qdrant Cloud)
# Create a free cluster at https://cloud.qdrant.io and copy the URL + API key.
# Both values must ALSO be set on the Convex deployment:
#   npx convex env set QDRANT_URL https://...your-cluster.qdrant.io
#   npx convex env set QDRANT_API_KEY your_qdrant_api_key
QDRANT_URL=https://your-cluster.qdrant.io
QDRANT_API_KEY=your_qdrant_api_key_here

# OpenAI Configuration for Embeddings (Vercel AI SDK)
# Also set on Convex: npx convex env set OPENAI_API_KEY ...
OPENAI_API_KEY=your_openai_api_key_here
