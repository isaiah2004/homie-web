# Dev mode — bypass Clerk + use seeded test users. Set this to "true" to
# run the app without any Clerk setup; a floating picker in the bottom-right
# lets you switch between seeded users. Requires CONVEX_DEV_MODE=true on
# the Convex deployment too (set via `npx convex env set`).
NEXT_PUBLIC_DEV_MODE=false

# Vapi Configuration
NEXT_PUBLIC_VAPI_API_KEY=your_api_key_here
NEXT_PUBLIC_VAPI_ASSISTANT_ID=your_assistant_id_here

# Vapi Webhook Secret — the Bearer token you set in the Vapi dashboard
# under each tool's Server Settings → Credential → Bearer Token.
# Your /api/vapi/webhook route checks this to verify requests come from Vapi.
VAPI_WEBHOOK_SECRET=your_vapi_webhook_secret_here

# Optional: Vapi Server URL (defaults to production)
# NEXT_PUBLIC_VAPI_BASE_URL=https://api.vapi.ai

# Qdrant Configuration for Vector Search (Qdrant Cloud)
# Create a free cluster at https://cloud.qdrant.io and copy the URL + API key.
# Both values must ALSO be set on the Convex deployment:
#   npx convex env set QDRANT_URL https://...your-cluster.qdrant.io
#   npx convex env set QDRANT_API_KEY your_qdrant_api_key
QDRANT_URL=https://your-cluster.qdrant.io
QDRANT_API_KEY=your_qdrant_api_key_here

# Google AI Studio API Key — powers the Homie chat agent
# (gemini-3.1-flash-lite). Get one at https://aistudio.google.com/apikey
# MUST ALSO be set on Convex: npx convex env set GOOGLE_GENERATIVE_AI_API_KEY ...
GOOGLE_GENERATIVE_AI_API_KEY=your_google_ai_studio_key_here

# OpenAI Configuration for Embeddings (Vercel AI SDK)
# Still required because embeddings (text-embedding-3-small) feed Qdrant.
# Also set on Convex: npx convex env set OPENAI_API_KEY ...
OPENAI_API_KEY=your_openai_api_key_here
