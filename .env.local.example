# Dev mode — bypass Clerk + use seeded test users. Set this to "true" to
# run the app without any Clerk setup; a floating picker in the bottom-right
# lets you switch between seeded users. Requires CONVEX_DEV_MODE=true on
# the Convex deployment too (set via `npx convex env set`).
NEXT_PUBLIC_DEV_MODE=false

# Google AI Studio API Key — powers the Homie chat agent
# (gemini-3.1-flash-lite). https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=your_google_ai_studio_key_here

# OpenAI API Key — still required for embeddings (text-embedding-3-small)
OPENAI_API_KEY=your_openai_api_key_here

# Vapi API Configuration
NEXT_PUBLIC_VAPI_API_KEY=your_vapi_api_key_here
NEXT_PUBLIC_VAPI_ASSISTANT_ID=your_vapi_assistant_id_here

# Vapi Webhook Secret — must match the Bearer token in Vapi dashboard
VAPI_WEBHOOK_SECRET=your_vapi_webhook_secret_here
